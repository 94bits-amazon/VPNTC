# Flask
FLASK_ENV=production
SECRET_KEY=troque_por_uma_chave_aleatoria_segura_aqui
TZ=America/Sao_Paulo

# Active Directory / LDAPS
LDAP_SERVER=ldaps://dc01.seudominio.local:636
LDAP_USE_SSL=true
LDAP_VALIDATE_CERT=false
LDAP_BASE_DN=DC=seudominio,DC=local
LDAP_USER_SEARCH_BASE=OU=Usuarios,DC=seudominio,DC=local
LDAP_BIND_DN=CN=svc-vpntc,OU=Servicos,DC=seudominio,DC=local
LDAP_BIND_PASSWORD=senha_super_secreta_aqui

# DNs Completos dos Grupos Reais de VPN no AD
GROUP_DN_nome1=CN=XXX-XXX-XXX-XXX,OU=Grupos,DC=seudominio,DC=local
GROUP_DN_nome2=CN=XXX-XXX-XXX-XXX,OU=Grupos,DC=seudominio,DC=local

# Scheduler (intervalo de verificação de vencimentos em minutos)
EXPIRATION_CHECK_INTERVAL_MINUTES=15

# Modo Dev (simula header do Authelia caso rode fora do Traefik para testes)
DEV_MOCK_USER=